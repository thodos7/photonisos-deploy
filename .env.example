# Copy this file to ".env" and fill it in:   cp .env.example .env && chmod 600 .env
# NEVER commit ".env" to GitHub.

WP_IMAGE=wordpress:php8.2-apache
DB_IMAGE=mysql:8.4
WPCLI_IMAGE=wordpress:cli-php8.2

# The ONE port this project publishes on the VM
WEB_PORT=8088
WEB_BIND=0.0.0.0

# Bulk storage (photos, backups, transfer files)
DATA_DIR=/mnt/ai4talos/photonisos

DB_NAME=photonisos
DB_USER=photonisos
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME_TOO

DISABLE_WP_CRON=false
